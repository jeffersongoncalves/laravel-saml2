{
    "name": "jeffersongoncalves/laravel-saml2",
    "description": "Multi-tenant SAML2 Service Provider for Laravel. Connect any number of Identity Providers (Entra ID, Okta, Google Workspace, Keycloak, ADFS, OneLogin) on top of the OneLogin toolkit.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "saml",
        "saml2",
        "sso",
        "single-sign-on",
        "multi-tenant",
        "onelogin",
        "azure-ad",
        "entra-id",
        "okta",
        "keycloak",
        "adfs"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-saml2",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "onelogin/php-saml": "^4.2",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LaravelSaml2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LaravelSaml2\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LaravelSaml2\\Saml2ServiceProvider"
            ],
            "aliases": {
                "Saml2": "JeffersonGoncalves\\LaravelSaml2\\Facades\\Saml2"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
